{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "uid": "mcpa-operations",
  "title": "Managed CPA operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": ["mcpa"],
  "panels": [
    {
      "id": 1,
      "title": "Model calls by status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(mcpa_calls_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Call error ratio (internal and dependency)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mcpa:call_errors:ratio5m",
          "legendFormat": "error ratio"
        }
      ]
    },
    {
      "id": 3,
      "title": "Call p95 duration by format",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (format, le) (rate(mcpa_call_duration_seconds_bucket[5m])))",
          "legendFormat": "{{format}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Provider failures by class",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider, status_class) (rate(mcpa_provider_failures_total[5m]))",
          "legendFormat": "{{provider}} {{status_class}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Delcore failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rpc, kind) (rate(mcpa_delcore_failures_total[5m]))",
          "legendFormat": "{{rpc}} {{kind}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Billing outbox pending and poisoned",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mcpa:outbox_pending:max",
          "legendFormat": "pending"
        },
        {
          "refId": "B",
          "expr": "mcpa:outbox_poisoned:max",
          "legendFormat": "poisoned"
        }
      ]
    },
    {
      "id": 7,
      "title": "Oldest pending billing event age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mcpa:outbox_oldest_pending_age_seconds:max",
          "legendFormat": "age seconds"
        }
      ]
    },
    {
      "id": 8,
      "title": "Billing outbox delivery failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (category) (rate(mcpa_outbox_delivery_failures_total[5m]))",
          "legendFormat": "{{category}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Metering checkpoint failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mcpa:checkpoint_failures:5m",
          "legendFormat": "failures per 5m"
        }
      ]
    },
    {
      "id": 10,
      "title": "Budget rejections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (scope) (rate(mcpa_budget_rejections_total[5m]))",
          "legendFormat": "{{scope}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "Billable bytes by segment",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (segment) (rate(mcpa_billable_bytes_total[5m]))",
          "legendFormat": "{{segment}}"
        }
      ]
    },
    {
      "id": 12,
      "title": "HTTP requests by surface",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (surface, code_class) (rate(mcpa_http_requests_total[5m]))",
          "legendFormat": "{{surface}} {{code_class}}"
        }
      ]
    },
    {
      "id": 13,
      "title": "Firing alerts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\",alertname=~\"Mcpa.*\"}",
          "legendFormat": "{{alertname}} {{severity}}"
        }
      ]
    }
  ]
}
