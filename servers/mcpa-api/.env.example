# SPDX-License-Identifier: FSL-1.1-ALv2
# Names, placeholders and safe loopback defaults only. Supply operator-owned
# values; empty required settings deliberately fail startup.
LISTEN=127.0.0.1:46329
DATABASE_URL=postgres://mcpa:local-mcpa@127.0.0.1:55438/mcpa?sslmode=disable
MCPA_PUBLIC_URL=http://127.0.0.1:46329
WEB_ORIGIN=http://127.0.0.1:46328
MCPA_WEB_RETURN_URLS=["http://127.0.0.1:46328/"]
# JSON object of key ID to an operator-generated random 32-byte key, encoded
# as unpadded base64url. Never reuse a development key elsewhere.
MCPA_MASTER_KEYS=
MCPA_ACTIVE_KEY_ID=
# Delcore service UUID of the mcpa service registered with PutService.
MCPA_SERVICE_ID=
DELCORE_URL=
DELCORE_RESOURCE=
LOGTO_TOKEN_URL=
CLIENT_ID=
CLIENT_SECRET=
LOGTO_ISSUER=
MCPA_LOGTO_CLIENT_ID=
MCPA_LOGTO_CLIENT_SECRET=
MCPA_API_RESOURCE=http://127.0.0.1:46329
MCPA_MCP_RESOURCE=http://127.0.0.1:46329/mcp
MCPA_MFA_CLAIM=mcpa_mfa
MCPA_MFA_REAUTH_URL=
# Approved MCP clients: {"<client_id>":{"name":"...","redirect_uris":["..."]}}
MCPA_OAUTH_CLIENTS={}
# Go durations. Allowed Delcore results are cached for the authorize TTL;
# metering checkpoints commit every checkpoint interval; the outbox worker
# runs every outbox interval, which is also its first retry backoff.
MCPA_AUTHORIZE_CACHE_TTL=30s
MCPA_CHECKPOINT_INTERVAL=5s
MCPA_OUTBOX_INTERVAL=10s
MCPA_METRICS_TOKEN=
DEPENDENCY_TIMEOUT=5s
LOG_FORMAT=text
# Set NO_COLOR to any value to disable ANSI color in text logs.
NO_COLOR=
OTEL_EXPORTER_OTLP_ENDPOINT=
