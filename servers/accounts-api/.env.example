# delino-accounts-api configuration.
# Contract: docs/servers-delino-accounts-api-foundation.md

# Listen address in host:port form. Default: 127.0.0.1:8100 (loopback only).
DELINO_ACCOUNTS_API_ADDR=127.0.0.1:8100

# One of: debug, info, warn, error. Default: info.
DELINO_ACCOUNTS_API_LOG_LEVEL=info
