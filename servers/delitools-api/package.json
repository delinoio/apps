{
  "name": "@delinoio/delitools-api",
  "version": "0.1.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "scripts": {
    "dev": "infisical run --env=dev --project-config-dir=../.. --path=/delitools-api -- node ../scripts/dev-api.mjs delitools",
    "ci:format": "cargo fmt --manifest-path ../Cargo.toml --all --check",
    "ci:vet": "cargo clippy --locked --manifest-path ../Cargo.toml -p delitools-api --all-targets -- -D warnings",
    "ci:build": "cargo build --locked --manifest-path ../Cargo.toml -p delitools-api",
    "ci:unit": "cargo test --locked --manifest-path ../Cargo.toml -p delitools-api",
    "ci:integration": "cargo test --locked --manifest-path ../Cargo.toml -p delitools-api -- --ignored",
    "ci:oci": "node scripts/oci-test.mjs",
    "build": "cargo build --locked --manifest-path ../Cargo.toml -p delitools-api",
    "ci:checks": "cargo test --locked --manifest-path ../Cargo.toml -p delitools-api"
  }
}
