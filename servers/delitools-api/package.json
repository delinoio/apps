{
  "name": "@delinoio/delitools-api",
  "version": "0.1.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "scripts": {
    "ci:format": "node ../../scripts/ci/check-go-format.mjs servers/delitools-api",
    "ci:vet": "go vet ./...",
    "ci:build": "go build -o /tmp/delitools-api-validation ./cmd/delitools-api",
    "ci:unit": "go test -count=1 ./...",
    "ci:integration": "go test -count=1 -race -tags=integration ./...",
    "ci:oci": "node ../../scripts/ci/from-root.mjs docker build -f servers/delitools-api/Dockerfile -t delitools-api:validation . && go test -count=1 -timeout=10m -tags=oci ./internal/api"
  }
}
