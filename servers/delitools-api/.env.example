# FSL-1.1-ALv2. Local examples only; supply real values outside Git.
DELITOOLS_DATABASE_URL=postgres://postgres:replace-me@127.0.0.1:5432/delitools?sslmode=disable
DELITOOLS_GATEWAY_KEY=replace-with-gateway-key
DELITOOLS_CLIENT_SECRET=replace-with-logto-m2m-secret
# Optional OTLP collector; apply a 30-day retention policy outside this process.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
