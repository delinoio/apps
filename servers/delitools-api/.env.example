# SPDX-License-Identifier: FSL-1.1-ALv2
# Copy to .env in the service working directory. Process variables take precedence.
# Replace all placeholders. Numeric limits are examples, not recommendations: the contract
# defines no defaults and startup rejects a missing or invalid value.
LISTEN=127.0.0.1:46322
DATABASE_URL=postgres://delitools:local-delitools@127.0.0.1:55434/delitools?sslmode=disable
ISSUER=https://logto.example.invalid/oidc
AUDIENCE=https://delitools.example.invalid
OPERATOR_ROLE=delitools-operator
DELCORE_URL=https://delcore.example.invalid
DELCORE_RESOURCE=https://delcore.example.invalid
LOGTO_TOKEN_URL=https://logto.example.invalid/oidc/token
CLIENT_ID=REPLACE
CLIENT_SECRET=REPLACE
# Registered delcore service UUID v7 for the service named delitools.
SERVICE_ID=01900000-0000-7000-8000-000000000001
GATEWAY_URL=https://ai-gateway.example.invalid
GATEWAY_KEY=REPLACE
# Outbound dependency and request deadline in seconds (1 to 120).
TIMEOUT_SECONDS=20
MAX_GATEWAY_RESPONSE_BYTES=4194304
# Optional: text or json.
# LOG_FORMAT=json
# Initial execution settings. They seed the database once; afterwards only the audited
# UpdateSettings RPC changes them. TRANSLATION_MODELS is a JSON array.
MAX_INPUT_BYTES=262144
MAX_TRANSLATION_ITEMS=100
EXECUTION_TIMEOUT_SECONDS=60
TENANT_REQUESTS_PER_MINUTE=120
TENANT_CONCURRENCY=4
MAX_AI_RETRIES=2
PRICE_SYNC_SECONDS=3600
DELIVERY_RETRY_SECONDS=30
MAX_BACKOFF_SECONDS=3600
ALERT_BACKLOG=1000
ALERT_EXPIRY_SECONDS=259200
TRANSLATION_MODELS='["openai/gpt-6-luna"]'
# Disposable test database only. Integration tests require a real PostgreSQL server.
TEST_DATABASE_URL=postgres://delitools:local-delitools@127.0.0.1:55434/delitools_test?sslmode=disable
# Optional OTLP endpoint. Enable only with a local collector; keep credentials uncommitted.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
