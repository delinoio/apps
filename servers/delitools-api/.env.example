# Disposable or development PostgreSQL only. Run `delitools-api migrate` before serving.
# Root `pnpm dev` replaces this with the local Compose database after Infisical injection.
DATABASE_URL=postgres://localhost:5432/delitools?sslmode=disable
LISTEN=127.0.0.1:46322
# This service's own Delcore consumer identity. Register it in Delcore with the authorize and
# usage:write scopes and the translate and extract capabilities.
DELCORE_URL=https://delcore.api.delino.io
DELCORE_RESOURCE=
LOGTO_TOKEN_URL=
CLIENT_ID=
CLIENT_SECRET=
# Delcore service ID of DeliTools (UUID v7). Events carry it and catalog prices are matched to it.
DELITOOLS_SERVICE_ID=
# Vercel AI Gateway (OpenAI-compatible). The base URL defaults to https://ai-gateway.vercel.sh/v1.
AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# Model allowlist and meter mapping (JSON when the path ends in .json, otherwise YAML).
DELITOOLS_MODELS=./models.example.yaml
# Optional limits. Defaults are listed in the README.
# DELITOOLS_MAX_INPUT_BYTES=262144
# DELITOOLS_MAX_TRANSLATION_ITEMS=200
# DELITOOLS_MAX_SCHEMA_BYTES=32768
# DELITOOLS_MAX_OUTPUT_TOKENS=16384
# DELITOOLS_EXECUTION_TIMEOUT=120s
# DELITOOLS_TENANT_RATE_PER_SECOND=5
# DELITOOLS_TENANT_RATE_BURST=10
# DELITOOLS_TENANT_CONCURRENCY=4
# DELITOOLS_MAX_RETRIES=2
# DELITOOLS_RETRY_BASE_DELAY=250ms
# DELITOOLS_RETRY_MAX_DELAY=5s
# DEPENDENCY_TIMEOUT=3s
# DELITOOLS_PRICE_CACHE_TTL=30s
# Optional usage delivery settings.
# DELITOOLS_OUTBOX_INTERVAL=5s
# DELITOOLS_OUTBOX_BATCH=50
# DELITOOLS_OUTBOX_BACKOFF_MIN=5s
# DELITOOLS_OUTBOX_BACKOFF_MAX=15m
# DELITOOLS_OUTBOX_ALERT_BACKLOG=1000
# DELITOOLS_OUTBOX_ALERT_AGE=15m
# Disposable test database only. Integration tests require a real PostgreSQL server.
TEST_DATABASE_URL=postgres://delitools:REPLACE@127.0.0.1:5432/delitools_test?sslmode=disable
# Optional log format: text (default, colored unless NO_COLOR is set) or json.
# LOG_FORMAT=text
# Optional OTLP endpoint. Do not commit real collector credentials.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
