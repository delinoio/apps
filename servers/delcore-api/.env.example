# Development server configuration. Use an absolute path outside the checkout.
CONFIG=/absolute/path/to/delcore.json
# Sample client user access token. Obtain it from your own Logto deployment.
DELCORE_ACCESS_TOKEN=REPLACE
# Disposable test database only. Integration tests require a real PostgreSQL server.
TEST_DATABASE_URL=postgres://delcore:REPLACE@127.0.0.1:5432/delcore_test?sslmode=disable
# Optional OTLP endpoint. Do not commit real collector credentials.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
