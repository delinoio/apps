# SPDX-License-Identifier: FSL-1.1-ALv2
# Copy to .env in the service working directory. Process variables take precedence.
# Replace all placeholders. Retention periods are examples; choose deployment policies.
# Keep IDENTITY_KEY stable across updates. RETURN_URLS is a JSON array.
LISTEN=127.0.0.1:8080
DATABASE_URL=postgres://delcore:REPLACE@127.0.0.1:5432/delcore?sslmode=disable
ISSUER=https://logto.example.invalid/oidc
AUDIENCE=https://delcore.example.invalid
OPERATOR_ROLE=delcore-operator
IDENTITY_KEY=REPLACE_WITH_PERSISTENT_RANDOM_SECRET
PADDLE_URL=https://sandbox-api.paddle.com
PADDLE_CREDIT_PRODUCT_ID=pro_REPLACE
PADDLE_TOKEN=REPLACE
PADDLE_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET
EMAIL_URL=https://api.cloudflare.com/client/v4
EMAIL_TOKEN=REPLACE
EMAIL_ACCOUNT=REPLACE
EMAIL_SENDER=billing@example.invalid
RETURN_URLS='["https://consumer.example.invalid/delcore/return"]'
TIMEOUT_SECONDS=20
RETRY_LIMIT=8
RETRY_SECONDS=30
MAX_PAYLOAD_BYTES=1048576
REQUESTS_PER_MINUTE=600
INVITATION_SECONDS=172800
# Serving DeliTools requires DELITOOLS_ENABLED=true, which validates that both
# reporting windows are at least 2592000 seconds (30 days) and that raw usage and
# webhook retention cover them. DeliTools keeps unconfirmed usage reports for 30
# days; delcore accepts them for the whole period. Registering the "delitools"
# service while the switch is false is rejected. Installations that do not serve
# DeliTools may leave the switch false and choose shorter windows.
DELITOOLS_ENABLED=true
USAGE_LATENESS_SECONDS=2592000
REPORTING_GRACE_SECONDS=2592000
DELETION_GRACE_SECONDS=2592000
RAW_USAGE_RETENTION_SECONDS=7776000
ACCOUNTING_RETENTION_SECONDS=220752000
AUDIT_RETENTION_SECONDS=220752000
WEBHOOK_RETENTION_SECONDS=7776000
BACKLOG_ALERT=1000
SETTLEMENT_ALERT_SECONDS=86400
# Event metering admission bounds per tenant, meter, and billing period.
# Required base-10 integers from 1 to 1000000; read at startup, so restart after changes.
# MAX_METER_GROUPS bounds groups; MAX_METER_GROUP_VALUES bounds distinct values per
# group for min, max, and unique_count meters. These are examples, not recommendations.
MAX_METER_GROUPS=1000
MAX_METER_GROUP_VALUES=10000
DEVELOPMENT=true
# Optional development YAML catalog directory, read only when DEVELOPMENT=true.
# Default: servers/delcore-api/catalog (catalog from this directory). Relative paths
# use the service working directory. The directory must exist and contain .yaml or
# .yml files. Restart the API after YAML edits.
# CATALOG_DIR=catalog
# Sample client user access token. Obtain it from your own Logto deployment.
DELCORE_ACCESS_TOKEN=REPLACE
# Sample client service M2M token for the event metering flow; pass the
# registered service ID with -service. Obtain it from your own Logto deployment.
DELCORE_SERVICE_TOKEN=REPLACE
# Disposable test database only. Integration tests require a real PostgreSQL server.
TEST_DATABASE_URL=postgres://delcore:REPLACE@127.0.0.1:5432/delcore_test?sslmode=disable
# Optional OTLP endpoint. Enable only with a local collector; keep credentials uncommitted.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
