{
  "name": "@servers/delcore-api",
  "version": "0.2.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "scripts": {
    "dev": "infisical run --env=dev --project-config-dir=../.. --path=/delcore-api -- portless run --name delcore-api --app-port 8080 node ../scripts/dev-api.mjs delcore",
    "ci:format": "cargo fmt --manifest-path ../Cargo.toml --all --check",
    "ci:vet": "cargo clippy --locked --manifest-path ../Cargo.toml -p delcore-api --all-targets -- -D warnings",
    "ci:build": "cargo build --locked --manifest-path ../Cargo.toml -p delcore-api",
    "ci:unit": "cargo test --locked --manifest-path ../Cargo.toml -p delcore-api",
    "ci:integration": "cargo test --locked --manifest-path ../Cargo.toml -p delcore-api -- --ignored",
    "ci:oci": "node scripts/oci-test.mjs",
    "build": "cargo build --locked --manifest-path ../Cargo.toml -p delcore-api",
    "ci:checks": "cargo test --locked --manifest-path ../Cargo.toml -p delcore-api"
  }
}
