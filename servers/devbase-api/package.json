{
  "name": "@delinoio/devbase-api",
  "version": "0.1.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "scripts": {
    "dev": "infisical run --env=dev --project-config-dir=../.. --path=/devbase-api -- node ../scripts/dev-api.mjs devbase",
    "ci:format": "cargo fmt --manifest-path ../Cargo.toml --all --check",
    "ci:vet": "cargo clippy --locked --manifest-path ../Cargo.toml -p devbase-api --all-targets -- -D warnings",
    "ci:build": "cargo build --locked --manifest-path ../Cargo.toml -p devbase-api",
    "ci:unit": "cargo test --locked --manifest-path ../Cargo.toml -p devbase-api",
    "ci:integration": "cargo test --locked --manifest-path ../Cargo.toml -p devbase-api --test postgres -- --ignored",
    "ci:oci": "node ../../scripts/ci/from-root.mjs docker build -f servers/devbase-api/Dockerfile -t devbase-api:validation .",
    "build": "cargo build --locked --manifest-path ../Cargo.toml -p devbase-api",
    "ci:checks": "cargo test --locked --manifest-path ../Cargo.toml -p devbase-api"
  }
}
