# Disposable or development PostgreSQL only. Run `devbase-api migrate` before serving.
# Root `pnpm dev` replaces this with the local Compose database after Infisical injection.
DATABASE_URL=postgres://localhost:5432/devbase?sslmode=disable
LISTEN=127.0.0.1:46317
# This service's own Delcore consumer identity. Register it in Delcore with the authorize scope.
DELCORE_URL=https://delcore.api.delino.io
DELCORE_RESOURCE=
LOGTO_TOKEN_URL=
CLIENT_ID=
CLIENT_SECRET=
# Optional limit and timeout overrides. Defaults are listed in the server contract.
# MAX_PROJECTS_PER_TENANT=100
# MAX_USERS_PER_PROJECT=1000000
# MAX_ACTIVE_KEYS_PER_PROJECT=20
# USER_RATE_PER_SECOND=1000
# USER_RATE_BURST=2000
# MANAGEMENT_RATE_PER_SECOND=50
# MANAGEMENT_RATE_BURST=100
# DEPENDENCY_TIMEOUT=3s
# REQUEST_TIMEOUT=10s
# CLEANUP_INTERVAL=5m
# Disposable test database only. Integration tests require a real PostgreSQL server.
TEST_DATABASE_URL=postgres://devbase:REPLACE@127.0.0.1:5432/devbase_test?sslmode=disable
# Optional log format: text (default, colored unless NO_COLOR is set) or json.
# LOG_FORMAT=text
# Optional OTLP endpoint. Do not commit real collector credentials.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
