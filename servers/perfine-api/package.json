{
  "name": "@servers/perfine-api",
  "version": "0.1.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "scripts": {
    "dev": "infisical run --env=dev --project-config-dir=../.. --path=/perfine-api -- portless run --name perfine-api --app-port 46323 node ../scripts/dev-api.mjs perfine",
    "ci:checks": "cargo test --locked --manifest-path ../Cargo.toml -p perfine-api",
    "build": "cargo build --locked --manifest-path ../Cargo.toml -p perfine-api",
    "ci:format": "cargo fmt --manifest-path ../Cargo.toml --all --check",
    "ci:unit": "cargo test --locked --manifest-path ../Cargo.toml -p perfine-api",
    "ci:integration": "cargo test --locked --manifest-path ../Cargo.toml -p perfine-api --test postgres -- --ignored",
    "ci:build": "cargo build --locked --manifest-path ../Cargo.toml -p perfine-api",
    "ci:vet": "cargo clippy --locked --manifest-path ../Cargo.toml -p perfine-api --all-targets -- -D warnings",
    "ci:oci": "node ../../scripts/ci/from-root.mjs docker build -f servers/perfine-api/Dockerfile -t perfine-api:validation ."
  }
}
