{
  "name": "@servers/anydash-api",
  "version": "0.0.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "scripts": {
    "dev": "infisical run --env=dev --project-config-dir=../.. --path=/anydash-api -- portless run --name anydash-api --app-port 46331 node ../scripts/dev-api.mjs anydash",
    "ci:checks": "cargo test --locked --manifest-path ../Cargo.toml -p anydash-api",
    "build": "cargo build --locked --manifest-path ../Cargo.toml -p anydash-api",
    "ci:format": "cargo fmt --manifest-path ../Cargo.toml --all --check",
    "ci:unit": "cargo test --locked --manifest-path ../Cargo.toml -p anydash-api",
    "ci:integration": "cargo test --locked --manifest-path ../Cargo.toml -p anydash-api -- --ignored",
    "ci:build": "cargo build --locked --manifest-path ../Cargo.toml -p anydash-api",
    "ci:vet": "cargo clippy --locked --manifest-path ../Cargo.toml -p anydash-api --all-targets -- -D warnings",
    "ci:oci": "node ../../scripts/ci/from-root.mjs docker build -f servers/anydash-api/Dockerfile -t anydash-api:validation ."
  }
}
