{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "uid": "anydash-operations",
  "title": "AnyDash operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": ["anydash"],
  "panels": [
    {
      "id": 1,
      "title": "API request rate by outcome",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, outcome) (rate(anydash_api_requests_total[5m]))",
          "legendFormat": "{{service}} {{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "API server error fraction (5 min)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "anydash:api_server_errors:ratio5m",
          "legendFormat": "server errors"
        }
      ]
    },
    {
      "id": 3,
      "title": "API p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(anydash_api_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Worker job runs by outcome",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (worker_job, outcome) (increase(anydash_worker_job_runs_total[1h]))",
          "legendFormat": "{{worker_job}} {{outcome}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Seconds since last successful worker job",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max by (worker_job) (anydash_worker_job_last_success_timestamp_seconds)",
          "legendFormat": "{{worker_job}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Pending deletion jobs and oldest age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(anydash_deletion_jobs_pending)",
          "legendFormat": "pending"
        }
      ]
    },
    {
      "id": 7,
      "title": "Oldest pending deletion age (s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(anydash_deletion_oldest_pending_age_seconds)",
          "legendFormat": "oldest age"
        }
      ]
    },
    {
      "id": 8,
      "title": "Hours since last LiteLLM price sync",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(time() - max(anydash_price_sync_last_success_timestamp_seconds)) / 3600",
          "legendFormat": "hours"
        }
      ]
    },
    {
      "id": 9,
      "title": "Collection snapshots by provider and status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider, status) (increase(anydash_collection_snapshots_total[1h]))",
          "legendFormat": "{{provider}} {{status}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Provider collection failure fraction (1 h)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "anydash:collection_failures:ratio1h",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "Partial aggregation fraction (1 h)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "anydash:parser_partial:ratio1h",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "id": 12,
      "title": "Active leases and failovers",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(anydash_leases_active)",
          "legendFormat": "active leases"
        }
      ]
    },
    {
      "id": 13,
      "title": "Lease failovers per hour",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider) (increase(anydash_lease_failovers_total[1h]))",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "id": 14,
      "title": "Firing AnyDash alerts",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertname=~\"AnyDash.*\",alertstate=\"firing\"}",
          "legendFormat": "{{alertname}}"
        }
      ]
    }
  ]
}
