# SPDX-License-Identifier: FSL-1.1-ALv2
# Names, placeholders and safe loopback defaults only. Real values come from the operator's
# deployment target or the /anydash-api Infisical development folder.
LISTEN=127.0.0.1:46331
DATABASE_URL=postgres://anydash:local-anydash@127.0.0.1:55439/anydash
ANYDASH_PUBLIC_URL=https://anydash.api.delino.io
WEB_ORIGIN=https://anydash.delino.io
LOGTO_ISSUER=
ANYDASH_RESOURCE=https://anydash.api.delino.io
DELCORE_URL=https://delcore.api.delino.io
DELCORE_RESOURCE=
LOGTO_TOKEN_URL=
CLIENT_ID=
CLIENT_SECRET=
# JSON object from every ClientKind value name except CLIENT_KIND_UNSPECIFIED to a minimum SemVer.
ANYDASH_MIN_CLIENT_VERSIONS={"CLIENT_KIND_CLI":"0.1.0","CLIENT_KIND_DESKTOP":"0.1.0","CLIENT_KIND_WEB":"0.1.0","CLIENT_KIND_IOS":"0.1.0","CLIENT_KIND_ANDROID":"0.1.0","CLIENT_KIND_NATIVE_WIDGET":"0.1.0"}
# Optional object of the same shape for update notices.
ANYDASH_LATEST_CLIENT_VERSIONS=
# Optional; defaults to the LiteLLM model_prices_and_context_window.json on GitHub.
ANYDASH_PRICING_URL=
# At least 32 characters; Prometheus sends it as a bearer credential.
ANYDASH_METRICS_TOKEN=
# Optional header set by a trusted reverse proxy with the client IP address, for example
# CF-Connecting-IP. Leave empty when clients connect directly.
ANYDASH_CLIENT_IP_HEADER=
DEPENDENCY_TIMEOUT=5s
LOG_FORMAT=json
RUST_LOG=info
