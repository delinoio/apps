# Supply operator-owned values; empty required limits deliberately fail startup.
LISTEN=127.0.0.1:46326
DATABASE_URL=postgres://lane:replace-me@127.0.0.1:55436/lane
LANE_PUBLIC_URL=https://lane.api.delino.io
WEB_ORIGIN=https://lane.delino.io
LANE_METRICS_TOKEN=
MAX_ITEM_BYTES=
MAX_WEBHOOK_BYTES=
REQUESTS_PER_MINUTE=
WEBHOOK_REQUESTS_PER_MINUTE=
AUTH_REQUESTS_PER_MINUTE=
LOGTO_ISSUER=
LANE_LOGTO_CLIENT_ID=
LANE_LOGTO_CLIENT_SECRET=
DELCORE_URL=https://delcore.api.delino.io
DELCORE_RESOURCE=
LOGTO_TOKEN_URL=
CLIENT_ID=
CLIENT_SECRET=
LANE_WEB_RETURN_URLS=["https://lane.delino.io/auth/callback"]
# Required client registry: keys are application IDs; redirects must match exactly.
LANE_OAUTH_CLIENTS={"lane-cli":{"name":"Lane CLI","redirect_uris":["lane://auth/callback","lane-dev://auth/callback"],"origin_kind":"ORIGIN_KIND_CLI","resource":"https://lane.api.delino.io"},"lane-native":{"name":"Lane","redirect_uris":["lane://auth/callback"],"origin_kind":"ORIGIN_KIND_APP","resource":"https://lane.api.delino.io"},"lane-native-dev":{"name":"Lane development","redirect_uris":["lane-dev://auth/callback"],"origin_kind":"ORIGIN_KIND_APP","resource":"https://lane.api.delino.io"}}
# Generate an operator-managed random 32-byte key, encoded as unpadded base64url.
LANE_WEBHOOK_ENCRYPTION_KEY=
LANE_WEBHOOK_BASE_URL=https://lane.api.delino.io
# Disabled providers retain pending work without claiming delivery.
LANE_APNS_ENABLED=false
LANE_APNS_PRIVATE_KEY=
LANE_APNS_KEY_ID=
LANE_APNS_TEAM_ID=
LANE_APNS_TOPIC=io.delino.lane
LANE_APNS_SANDBOX=false
LANE_FCM_ENABLED=false
LANE_FCM_PRIVATE_KEY=
LANE_FCM_CLIENT_EMAIL=
LANE_FCM_PROJECT_ID=
LANE_WEB_PUSH_ENABLED=false
LANE_WEB_PUSH_PRIVATE_KEY=
LANE_WEB_PUSH_SUBJECT=
LOG_FORMAT=json
RUST_LOG=info
