{
  "name": "@servers/lane-api",
  "version": "0.2.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "scripts": {
    "dev": "infisical run --env=dev --project-config-dir=../.. --path=/lane-api -- portless run --name lane-api --app-port 46326 node ../scripts/dev-api.mjs lane",
    "ci:checks": "cargo test --locked --manifest-path ../Cargo.toml -p lane-api",
    "build": "cargo build --locked --manifest-path ../Cargo.toml -p lane-api",
    "ci:format": "cargo fmt --manifest-path ../Cargo.toml --all --check",
    "ci:unit": "cargo test --locked --manifest-path ../Cargo.toml -p lane-api",
    "ci:integration": "cargo test --locked --manifest-path ../Cargo.toml -p lane-api -- --ignored",
    "ci:build": "cargo build --locked --manifest-path ../Cargo.toml -p lane-api",
    "ci:vet": "cargo clippy --locked --manifest-path ../Cargo.toml -p lane-api --all-targets -- -D warnings",
    "ci:oci": "node ../../scripts/ci/from-root.mjs docker build -f servers/lane-api/Dockerfile -t lane-api:validation ."
  }
}
