{
  "name": "perfine",
  "version": "0.1.0",
  "description": "Profile-backed local performance optimization",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "perfine": "bin/perfine.cjs"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "bin",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES",
    "provenance.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/delinoio/apps.git",
    "directory": "packages/perfine"
  },
  "scripts": {
    "test": "pnpm --dir ../../actions/perfine build && node --test scripts/*.test.mjs",
    "build": "pnpm --dir ../../actions/perfine build && node scripts/build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "release:verify": "node scripts/release.mjs verify"
  },
  "optionalDependencies": {
    "@delinoio/perfine-linux-x64": "0.1.0",
    "@delinoio/perfine-darwin-x64": "0.1.0",
    "@delinoio/perfine-darwin-arm64": "0.1.0",
    "@delinoio/perfine-win32-x64": "0.1.0"
  }
}
