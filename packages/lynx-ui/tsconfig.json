{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@lynx-js/react",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@lynx-js/types", "@lynx-js/react"]
  },
  "include": ["src", "examples", "tests", "*.config.ts"]
}
