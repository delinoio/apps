{
  "name": "@delino/lynx-ui",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./styles.css": "./src/styles.css",
    "./web": "./src/web.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rspeedy build && node scripts/build-web-host.mjs",
    "test": "pnpm typecheck && rstest && pnpm build"
  },
  "peerDependencies": {
    "@lynx-js/react": "^0.129.0",
    "@lynx-js/types": "^4.3.0"
  },
  "devDependencies": {
    "@lynx-js/react": "0.129.0",
    "@lynx-js/react-rsbuild-plugin": "0.22.0",
    "@lynx-js/rspeedy": "0.18.3",
    "@lynx-js/testing-environment": "0.4.0",
    "@lynx-js/types": "4.3.0",
    "@lynx-js/web-core": "0.26.5",
    "@lynx-js/web-elements": "0.12.15",
    "@rstest/core": "0.12.4",
    "@types/node": "24.19.2",
    "@types/react": "19.2.14",
    "jsdom": "20.0.3",
    "typescript": "5.9.3"
  }
}
