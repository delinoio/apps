{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["go.mod", "go.sum", "protos/**"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "outputs": ["dist/**"]
    },
    "build:frontend": {
      "outputs": ["dist/**"]
    },
    "test": {
      "cache": false
    }
  }
}
