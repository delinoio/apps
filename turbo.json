{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "go.mod",
    "go.sum",
    "protos/**",
    ".nvmrc",
    "pnpm-workspace.yaml",
    "packages/ui/**",
    "scripts/localization/**",
    "LICENSE",
    "NOTICE",
    "servers/Cargo.toml",
    "servers/Cargo.lock",
    "servers/crates/**"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "build:frontend": {
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "test": {
      "cache": false
    },
    "@delinoio/delcore-api#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "LISTEN",
        "DATABASE_URL",
        "ISSUER",
        "AUDIENCE",
        "OPERATOR_ROLE",
        "IDENTITY_KEY",
        "PADDLE_URL",
        "PADDLE_CREDIT_PRODUCT_ID",
        "PADDLE_TOKEN",
        "PADDLE_WEBHOOK_SECRET",
        "EMAIL_URL",
        "EMAIL_TOKEN",
        "EMAIL_ACCOUNT",
        "EMAIL_SENDER",
        "RETURN_URLS",
        "TIMEOUT_SECONDS",
        "RETRY_LIMIT",
        "RETRY_SECONDS",
        "MAX_PAYLOAD_BYTES",
        "REQUESTS_PER_MINUTE",
        "INVITATION_SECONDS",
        "USAGE_LATENESS_SECONDS",
        "REPORTING_GRACE_SECONDS",
        "DELETION_GRACE_SECONDS",
        "RAW_USAGE_RETENTION_SECONDS",
        "ACCOUNTING_RETENTION_SECONDS",
        "AUDIT_RETENTION_SECONDS",
        "WEBHOOK_RETENTION_SECONDS",
        "BACKLOG_ALERT",
        "SETTLEMENT_ALERT_SECONDS",
        "MAX_METER_GROUPS",
        "MAX_METER_GROUP_VALUES",
        "DEVELOPMENT",
        "CATALOG_DIR",
        "OTEL_*",
        "NO_COLOR",
        "DEV_COMPOSE_DATABASE_URLS",
        "CARGO_TARGET_DIR"
      ]
    },
    "@delinoio/devbase-api#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "LISTEN",
        "DELCORE_URL",
        "DELCORE_RESOURCE",
        "LOGTO_TOKEN_URL",
        "CLIENT_ID",
        "CLIENT_SECRET",
        "MAX_PROJECTS_PER_TENANT",
        "MAX_USERS_PER_PROJECT",
        "MAX_ACTIVE_KEYS_PER_PROJECT",
        "USER_RATE_PER_SECOND",
        "USER_RATE_BURST",
        "MANAGEMENT_RATE_PER_SECOND",
        "MANAGEMENT_RATE_BURST",
        "DEPENDENCY_TIMEOUT",
        "REQUEST_TIMEOUT",
        "CLEANUP_INTERVAL",
        "LOG_FORMAT",
        "OTEL_*",
        "NO_COLOR",
        "DEV_COMPOSE_DATABASE_URLS",
        "CARGO_TARGET_DIR"
      ]
    },
    "@delinoio/git-tracker-api#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "LISTEN",
        "WEB_ORIGIN",
        "AUDIT_RETENTION",
        "GITHUB_APP_ID",
        "GITHUB_KEY_FILE",
        "WEBHOOK_SECRET",
        "DELCORE_URL",
        "DELCORE_RESOURCE",
        "LOGTO_TOKEN_URL",
        "CLIENT_ID",
        "CLIENT_SECRET",
        "ALERT_*",
        "OTEL_*",
        "NO_COLOR",
        "DEV_COMPOSE_DATABASE_URLS",
        "CARGO_TARGET_DIR"
      ]
    },
    "fixkey-desktop#build": {
      "cache": false
    }
  },
  "globalEnv": ["NODE_ENV", "PUBLIC_*", "RUNNER_OS", "RUNNER_ARCH"],
  "globalPassThroughEnv": ["PORTLESS", "PORTLESS_*"]
}
