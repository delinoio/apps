{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": [
        "AI_GATEWAY_API_KEY",
        "VERCEL_OIDC_TOKEN",
        "CI",
        "E2E_*",
        "PLAYWRIGHT_BROWSERS_PATH"
      ]
    },
    "//#test:tooling": {
      "cache": false
    }
  }
}
