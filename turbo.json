{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["go.mod", "go.sum", "protos/**"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "outputs": ["dist/**"]
    },
    "build:frontend": {
      "outputs": ["dist/**"]
    },
    "test": {
      "cache": false
    },
    "@delinoio/delcore-api#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["CONFIG", "OTEL_*", "NO_COLOR"]
    },
    "@delinoio/git-tracker-api#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "LISTEN",
        "WEB_ORIGIN",
        "AUDIT_RETENTION",
        "GITHUB_APP_ID",
        "GITHUB_KEY_FILE",
        "WEBHOOK_SECRET",
        "DELCORE_URL",
        "DELCORE_RESOURCE",
        "LOGTO_TOKEN_URL",
        "CLIENT_ID",
        "CLIENT_SECRET",
        "ALERT_*",
        "OTEL_*",
        "NO_COLOR"
      ]
    }
  }
}
