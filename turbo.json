{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "go.mod",
    "go.sum",
    "protos/**",
    ".nvmrc",
    "pnpm-workspace.yaml",
    "packages/ui/**",
    "scripts/localization/**",
    "LICENSE",
    "NOTICE"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "build:frontend": {
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "test": {
      "cache": false
    },
    "@delinoio/delcore-api#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DELCORE_CONFIG", "OTEL_*", "NO_COLOR"]
    },
    "@delinoio/git-tracker-api#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["GIT_TRACKER_*", "OTEL_*", "NO_COLOR"]
    },
    "fixkey-desktop#build": {
      "cache": false
    }
  },
  "globalEnv": ["NODE_ENV", "PUBLIC_*", "RUNNER_OS", "RUNNER_ARCH"]
}
