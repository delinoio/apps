{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["go.mod", "go.sum", "protos/**"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "outputs": ["dist/**"]
    },
    "build:frontend": {
      "outputs": ["dist/**"]
    },
    "test": {
      "cache": false
    },
    "@delinoio/delcore-api#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DELCORE_CONFIG", "OTEL_*", "NO_COLOR"]
    },
    "@delinoio/git-tracker-api#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["GIT_TRACKER_*", "OTEL_*", "NO_COLOR"]
    }
  }
}
