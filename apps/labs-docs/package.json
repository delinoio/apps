{
  "name": "@apps/labs-docs",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "infisical run --env=dev --project-config-dir=../.. -- portless run --name labs-docs --app-port 46330 rspress dev",
    "build": "pnpm i18n:check && rspress build && cp \"../../LICENSE\" \"../../NOTICE\" \"doc_build/\"",
    "build:frontend": "pnpm build",
    "preview": "node scripts/preview.mjs",
    "test": "pnpm i18n:check && node --test ../../scripts/localization/*.test.mjs && pnpm build && pnpm ci:routes",
    "ci:routes": "node --test scripts/tairouter-content.test.mjs && node scripts/validate-routes.mjs",
    "i18n:check": "node ../../scripts/localization/cli.mjs check",
    "i18n:translate": "node ../../scripts/localization/cli.mjs translate",
    "i18n:login": "node ../../scripts/localization/cli.mjs login",
    "i18n:logout": "node ../../scripts/localization/cli.mjs logout",
    "i18n:models": "node ../../scripts/localization/cli.mjs models",
    "i18n:profiles": "node ../../scripts/localization/cli.mjs profiles",
    "ci:check": "pnpm i18n:check && node --test ../../scripts/localization/*.test.mjs",
    "ci:checks": "pnpm test"
  },
  "devDependencies": {
    "@rspress/core": "2.0.23",
    "entities": "6.0.1"
  }
}
