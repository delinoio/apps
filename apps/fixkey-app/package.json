{
  "name": "fixkey-desktop",
  "version": "0.1.9",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "infisical run --env=dev --project-config-dir=../.. -- rsbuild dev",
    "dev:desktop": "infisical run --env=dev --project-config-dir=../.. -- tauri dev --features desktop",
    "dev:frontend": "infisical run --env=dev --project-config-dir=../.. -- rsbuild dev",
    "build": "tauri build --features desktop",
    "build:frontend": "tsc --noEmit && rsbuild build",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && rstest && rsbuild build",
    "ci:check": "pnpm test && node --test scripts/release/*.test.mjs",
    "ci:desktop": "cargo test --locked --manifest-path src-tauri/Cargo.toml --features desktop --lib && cargo clippy --locked -p fixkey-core --features native --all-targets -- -D warnings && cargo clippy --locked --manifest-path src-tauri/Cargo.toml --features desktop --all-targets -- -D warnings"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@delino/ui": "workspace:*"
  },
  "devDependencies": {
    "@rsbuild/core": "2.1.10",
    "@rsbuild/plugin-react": "2.0.1",
    "@rstest/core": "0.12.4",
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "20.0.3",
    "typescript": "5.9.3"
  }
}
