# Public browser configuration only. Register /callback and the sign-out origin in Logto.
PUBLIC_LOGTO_ENDPOINT=https://identity.example.invalid
PUBLIC_LOGTO_APP_ID=replace-with-public-app-id
PUBLIC_DELCORE_API_URL=https://delcore.api.delino.io
PUBLIC_DELCORE_RESOURCE=https://delcore.api.delino.io
PUBLIC_PERFINE_API_URL=https://perfine.api.delino.io
PUBLIC_PERFINE_RESOURCE=https://delcore.api.delino.io
# GitHub App installation page configured by the operator (HTTPS github.com only).
PUBLIC_PERFINE_GITHUB_APP_URL=https://github.com/apps/replace-with-app-name/installations/new
