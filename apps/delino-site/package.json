{
  "name": "delino-site",
  "version": "0.1.6",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "infisical run --env=dev --project-config-dir=../.. -- rsbuild dev",
    "build": "pnpm i18n:check && rsbuild build && cp \"../../LICENSE\" \"../../NOTICE\" \"dist/\" && cp \"../../packages/ui/LICENSE.shadcn\" \"dist/LICENSE.shadcn\"",
    "typecheck": "tsc --noEmit",
    "test": "pnpm i18n:check && pnpm typecheck && pnpm build",
    "ci:checks": "pnpm test",
    "i18n:check": "node ../../scripts/localization/cli.mjs check",
    "i18n:translate": "node ../../scripts/localization/cli.mjs translate",
    "i18n:login": "node ../../scripts/localization/cli.mjs login",
    "i18n:logout": "node ../../scripts/localization/cli.mjs logout",
    "i18n:models": "node ../../scripts/localization/cli.mjs models",
    "i18n:profiles": "node ../../scripts/localization/cli.mjs profiles"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@delino/ui": "workspace:*"
  },
  "devDependencies": {
    "@rsbuild/core": "2.1.10",
    "@rsbuild/plugin-react": "2.0.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
