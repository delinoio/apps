<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- Hardened-runtime entitlements for the signed AnyDash desktop app. The
     Lynxtron runtime executes the main process and the Lynx bundle with a
     JIT-compiling JavaScript engine, which the hardened runtime blocks without
     these entitlements. Remove an entitlement only after the notarized app
     starts and renders without it. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
