{
  "name": "@apps/git-tracker",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "infisical run --env=dev --project-config-dir=../.. -- portless run --name git-tracker --app-port 46320 rsbuild dev",
    "build": "rsbuild build && cp \"../../LICENSE\" \"../../NOTICE\" \"dist/\"",
    "typecheck": "tsc --noEmit",
    "test": "pnpm typecheck && node --test tests/*.test.mjs && pnpm build",
    "ci:checks": "pnpm test"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@tanstack/react-query": "5.101.4",
    "@connectrpc/connect-query": "2.3.1",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0",
    "@bufbuild/protobuf": "2.16.0",
    "@logto/react": "4.1.1",
    "@repo/protos": "workspace:*"
  },
  "devDependencies": {
    "@rsbuild/core": "2.1.10",
    "@rsbuild/plugin-react": "2.0.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
