source 'https://cdn.cocoapods.org/'
source 'https://github.com/lynx-family/Specs.git'
platform :ios, '16.0'
project 'Lane.xcodeproj'
target 'Lane' do
  pod 'Lynx', '4.1.0', :subspecs => ['Framework']
  pod 'PrimJS', '4.1.1', :subspecs => ['quickjs', 'napi']
end

# Lynx 4.1 pods declare iOS 9/10 targets that current Xcode no longer supports.
# Match Lane's minimum until upstream podspecs use a supported deployment target.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      # SDK 4.1 treats warnings from newer Clang/libc++ headers as errors.
      # Keep warnings visible; remove when SDK flags support current Xcode.
      config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
      flags = config.build_settings['OTHER_CPLUSPLUSFLAGS'] || ['$(inherited)']
      flags = [flags] unless flags.is_a?(Array)
      config.build_settings['OTHER_CPLUSPLUSFLAGS'] = flags + ['-Wno-error']
    end
  end
end
