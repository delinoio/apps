          }
        ]
      },
      "expected": {
        "repository": null
      }
    },
    {
      "id": "select-page-credentials",
      "input": {
        "operation": "select",
        "page": "https://user@example.com/app",
        "rules": [
          {
            "prefix": "https://example.com/app",
            "repository": "a"
          }
        ]
      },
      "expected": {
        "repository": null
      }
    },
    {
      "id": "select-longest-prefix",
      "input": {
        "operation": "select",
        "page": "https://example.com/app/page/x",
        "rules": [
          {
            "prefix": "https://example.com/",
            "repository": "a"
          },
          {
            "prefix": "https://example.com/app",
            "repository": "b"
          },
          {
            "prefix": "https://example.com/app/page",
            "repository": "c"
          }
        ]
      },
      "expected": {
        "repository": "c"
      }
    },
    {
      "id": "select-longer-prefix",
      "input": {
        "operation": "select",
        "page": "https://example.com/app/other",
        "rules": [
          {
            "prefix": "https://example.com/",
            "repository": "a"
          },
          {
            "prefix": "https://example.com/app",
            "repository": "b"
          },
          {
            "prefix": "https://example.com/app/page",
            "repository": "c"
          }
        ]
      },
      "expected": {
        "repository": "b"
      }
    },
    {
      "id": "select-origin-root-rule",
      "input": {
        "operation": "select",
        "page": "https://example.com/other",
        "rules": [
          {
            "prefix": "https://example.com/",
            "repository": "a"
          },
          {
            "prefix": "https://example.com/app",
            "repository": "b"
          },
          {
            "prefix": "https://example.com/app/page",
            "repository": "c"
          }
        ]
      },
      "expected": {
        "repository": "a"
      }
    },
    {
      "id": "select-origin-root-rule-without-slash",
      "input": {
        "operation": "select",
        "page": "https://example.com",
        "rules": [
          {
            "prefix": "https://example.com/",
            "repository": "a"
          },
          {
            "prefix": "https://example.com/app",
            "repository": "b"
          },
          {
            "prefix": "https://example.com/app/page",
            "repository": "c"
          }
        ]
      },
      "expected": {
        "repository": "a"
      }
    },
    {
      "id": "select-conflict-excluded",
      "input": {
        "operation": "select",
        "page": "https://example.com/app/page",
        "rules": [
          {
            "prefix": "https://example.com/app",
            "repository": "a"
          },
          {
            "prefix": "https://example.com/app/page",
            "repository": "b",
            "conflict": true
          }
        ]
      },
      "expected": {
        "repository": "a"
      }
    },
    {
      "id": "select-idn-page-host",
      "input": {
        "operation": "select",
        "page": "https://BÜCHER.example/app/x",
        "rules": [
          {
            "prefix": "https://xn--bcher-kva.example/app",
            "repository": "a"
          }
        ]
      },
      "expected": {
        "repository": "a"
      }
    },
    {
      "id": "select-page-dot-segments",
      "input": {
        "operation": "select",
        "page": "https://example.com/x/../app/y",
        "rules": [
          {
            "prefix": "https://example.com/app",
            "repository": "a"
          }
        ]
      },
      "expected": {
        "repository": "a"
      }
    },
    {
      "id": "select-page-non-ascii-path",
      "input": {
        "operation": "select",
        "page": "https://example.com/café/x",
        "rules": [
          {
            "prefix": "https://example.com/caf%C3%A9",
            "repository": "a"
          }
        ]
      },
      "expected": {
        "repository": "a"
      }
    },
    {
      "id": "select-page-empty-port",
      "input": {
        "operation": "select",
        "page": "https://example.com:/app",
        "rules": [
          {
            "prefix": "https://example.com/app",
            "repository": "a"
          }
        ]
      },
      "expected": {
        "repository": "a"
      }
    },
    {
      "id": "duplicate-normalized-equal",
      "input": {
        "operation": "create",
        "prefixes": [
          "https://example.com/app",
          "HTTPS://EXAMPLE.COM:443/app/?x=1#y"
        ]
      },
      "expected": {
        "duplicateRejected": true
      }
    },
    {
      "id": "duplicate-path-case-distinct",
      "input": {
        "operation": "create",
        "prefixes": [
          "https://example.com/app",
          "https://example.com/App"
        ]
      },
      "expected": {
        "duplicateRejected": false
      }
    },
    {
      "id": "duplicate-port-distinct",
      "input": {
        "operation": "create",
        "prefixes": [
          "https://example.com/app",
          "https://example.com:8443/app"
        ]
      },
      "expected": {
        "duplicateRejected": false
      }
    }
  ]
}
