          }
        ]
      },
      "expected": {
        "repository": "a"
      }
    },
    {
      "id": "select-page-host-case-default-port",
      "input": {
        "operation": "select",
        "page": "https://EXAMPLE.com:443/app/x",
        "rules": [
          {
            "prefix": "https://example.com/app",
            "repository": "a"
          }
        ]
      },
      "expected": {
        "repository": "a"
      }
    },
    {
      "id": "select-other-scheme",
      "input": {
        "operation": "select",
        "page": "http://example.com/app",
        "rules": [
          {
            "prefix": "https://example.com/app",
