      "expected": {
        "repository": null
      }
    },
    {
      "id": "select-other-port",
      "input": {
        "operation": "select",
        "page": "https://example.com:8443/app",
        "rules": [
          {
            "prefix": "https://example.com/app",
            "repository": "a"
          }
        ]
      },
      "expected": {
        "repository": null
      }
    },
    {
      "id": "select-subdomain",
      "input": {
        "operation": "select",
        "page": "https://sub.example.com/app",
        "rules": [
          {
            "prefix": "https://example.com/app",
            "repository": "a"
          }
        ]
      },
      "expected": {
        "repository": null
      }
    },
    {
      "id": "select-other-host",
      "input": {
        "operation": "select",
        "page": "https://elsewhere.example/app",
        "rules": [
          {
            "prefix": "https://example.com/app",
            "repository": "a"
          }
        ]
      },
      "expected": {
        "repository": null
      }
    },
    {
      "id": "select-unsupported-page-scheme",
      "input": {
        "operation": "select",
        "page": "chrome://newtab",
        "rules": [
          {
            "prefix": "https://example.com/app",
