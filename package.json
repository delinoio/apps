{
  "name": "delino-apps",
  "packageManager": "pnpm@12.14.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "prepare": "./scripts/install-git-hooks.sh",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "i18n:check": "pnpm -r --if-present run i18n:check",
    "i18n:translate": "pnpm -r --workspace-concurrency=1 --if-present run i18n:translate",
    "i18n:login": "node scripts/localization/cli.mjs login",
    "i18n:logout": "node scripts/localization/cli.mjs logout",
    "i18n:models": "node scripts/localization/cli.mjs models",
    "i18n:profiles": "node scripts/localization/cli.mjs profiles",
    "format": "node scripts/ci/format-changed.mjs --write",
    "format:check": "node scripts/ci/format-changed.mjs",
    "proto:generate": "buf generate",
    "proto:lint": "buf lint && buf format --diff --exit-code",
    "test:tooling": "node --test scripts/*.test.mjs scripts/ci/*.test.mjs scripts/release/*.test.mjs"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.72.0",
    "jose": "6.2.12",
    "js-yaml": "4.3.2",
    "lefthook": "2.2.2",
    "rstack": "0.8.4",
    "turbo": "2.9.18",
    "@bufbuild/protoc-gen-es": "2.16.0"
  },
  "type": "module"
}
