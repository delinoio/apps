{
  "name": "delinoio-mono",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "prepare": "./scripts/install-git-hooks.sh",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test test:tooling",
    "test:e2e": "turbo run test:e2e",
    "test:tooling": "node --test scripts/ci/*.test.mjs",
    "format": "node scripts/ci/format-changed.mjs --write",
    "format:check": "node scripts/ci/format-changed.mjs"
  },
  "devDependencies": {
    "lefthook": "2.2.2",
    "rstack": "0.8.3",
    "turbo": "2.11.10"
  }
}
